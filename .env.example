# Where the main LilTeam Shop app's internal API lives. In production this
# MUST be the internal Docker service hostname (e.g. http://app:3000), NOT
# a public *.lilteam.site URL — the main app's tenant-resolver middleware
# treats any *.{MAIN_DOMAIN} Host header as a shop-subdomain lookup, and
# the internal API explicitly refuses to run in that context (see
# src/routes/internal-api.js's tenantShop check on the main app). Using the
# internal hostname keeps the Host header as something that never matches
# a shop slug, so it resolves as the main site every time.
MAIN_API_BASE_URL=http://app:3000

# Must match INTERNAL_API_SECRET on the main app exactly. Generate a long
# random value once (e.g. `openssl rand -hex 32`) and set it identically
# on both apps — never commit the real value.
INTERNAL_API_SECRET=change-this-to-a-long-random-value

# This app's own session signing secret — unrelated to the main app's
# SESSION_SECRET, since the two apps do not share sessions.
SESSION_SECRET=change-this-too

PORT=3000

# Optional branding overrides — the admin panel at /admin lets you change
# these live without touching this file, but they still work as the
# starting defaults before anyone's used the admin panel.
SHOP_NAME=LilTeam Shop
LOGO_IMAGE=

# Credentials for /admin (shop name + logo editor). Leave unset to disable
# the admin panel entirely.
ADMIN_USERNAME=
ADMIN_PASSWORD=
