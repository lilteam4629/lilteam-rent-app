<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/tailwind.generated.css"><%- include('_head-style') %><%- include('_theme-init') %></head>
<body class="admin-page"><div class="admin-content"><%- include('_admin-nav',{active:'rentals'}) %>
<% messages.error.forEach(m=>{ %><div class="bg-red-500/10 text-red-400 p-3 rounded-xl mb-3"><%= m %></div><% }) %><% messages.success.forEach(m=>{ %><div class="bg-emerald-500/10 text-emerald-400 p-3 rounded-xl mb-3"><%= m %></div><% }) %>
<div class="grid sm:grid-cols-3 gap-3 mb-6"><% [['ร้านทั้งหมด',rentedShops.length],['ร้านใช้งานอยู่',rentedShops.filter(s=>!s.expiresAt||s.expiresAt>Date.now()).length],['รายการชำระ',transactions.filter(t=>t.amount<0).length]].forEach(x=>{ %><div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-4"><p class="text-xs text-[var(--text-3)]"><%= x[0] %></p><b class="text-2xl"><%= x[1] %></b></div><% }) %></div>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5 mb-6">
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-3 mb-5"><div><p class="text-[10px] font-bold tracking-widest text-[var(--gold)]">MULTI-SITE CONTROL</p><h2 class="text-xl font-bold">เปิดหรือปิดระบบให้ร้านที่เลือก</h2><p class="text-xs text-[var(--text-3)] mt-1">แก้เฉพาะร้านที่ติ๊ก หรือใช้กับเว็บเช่าทั้งหมด ข้อมูลสินค้า ลูกค้า และคำสั่งซื้อจะไม่ถูกเปลี่ยน</p></div><span class="text-xs rounded-full border border-[var(--border)] bg-[var(--input)] px-3 py-1.5"><%= rentedShops.length %> ร้านในระบบ</span></div>
  <form action="/admin/rentals/features" method="post" id="tenant-feature-form" class="space-y-5">
    <div class="grid md:grid-cols-3 gap-3">
      <label class="text-xs font-semibold">ระบบที่ต้องการแก้<select name="feature" required class="mt-1.5 block w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl p-3"><% (featureCatalog||[]).forEach(feature=>{ %><option value="<%= feature.key %>"><%= feature.label %> — <%= feature.description %></option><% }) %></select></label>
      <label class="text-xs font-semibold">การทำงาน<select name="action" required class="mt-1.5 block w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl p-3"><option value="enable">เปิดใช้งาน</option><option value="disable">ปิดใช้งาน</option></select></label>
      <fieldset class="text-xs font-semibold"><legend>ขอบเขต</legend><div class="mt-1.5 flex min-h-[46px] items-center gap-4 rounded-xl border border-[var(--border-light)] bg-[var(--input)] px-3"><label><input type="radio" name="scope" value="selected" checked> ร้านที่เลือก</label><label><input type="radio" name="scope" value="all"> ทุกร้าน</label></div></fieldset>
    </div>
    <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-2 max-h-80 overflow-y-auto pr-1">
      <% rentedShops.forEach(shop=>{ %><label class="flex items-start gap-3 rounded-xl border border-[var(--border)] bg-[var(--input)] p-3 cursor-pointer hover:border-[var(--gold)]"><input type="checkbox" name="shopIds" value="<%= shop.id %>" class="mt-1"><span class="min-w-0 flex-1"><b class="block truncate"><%= shop.name %></b><small class="block text-[var(--text-4)] truncate"><%= shop.slug %> · <%= shop.ownerUsername %></small><span class="mt-2 flex flex-wrap gap-1"><% (featureCatalog||[]).forEach(feature=>{ const active=shop.features&&shop.features[feature.key]; %><i class="not-italic text-[9px] px-1.5 py-0.5 rounded-full <%= active?'bg-emerald-500/15 text-emerald-400':'bg-black/10 text-[var(--text-4)]' %>"><%= feature.label %>: <%= active?'เปิด':'ปิด' %></i><% }) %></span></span></label><% }) %>
      <% if(!rentedShops.length){ %><p class="col-span-full text-center text-sm text-[var(--text-3)] py-8">ยังไม่มีร้านเช่าในระบบ</p><% } %>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border)] pt-4"><p class="text-xs text-[var(--text-3)]">ระบบจะตรวจร้านทั้งหมดก่อนบันทึก และคืนค่าอัตโนมัติหากเกิดข้อผิดพลาด</p><button <%= !rentedShops.length||!(featureCatalog||[]).length?'disabled':'' %> class="rounded-xl bg-[var(--gold)] text-[var(--bg)] font-bold px-5 py-3 disabled:opacity-40">บันทึกฟีเจอร์</button></div>
  </form>
</section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto mb-6"><h2 class="font-semibold p-4">ร้านที่เช่าอยู่</h2><table class="w-full text-sm min-w-[760px]"><thead><tr><th class="p-3 text-left">ร้าน</th><th class="p-3 text-left">ผู้เช่า</th><th class="p-3 text-left">หมดอายุ</th><th class="p-3 text-right">จัดการ</th></tr></thead><tbody><% rentedShops.forEach(shop=>{ %><tr class="border-t border-[var(--border)]"><td class="p-3"><b><%= shop.name %></b><small class="block"><%= shop.slug %></small></td><td class="p-3"><%= shop.ownerUsername %></td><td class="p-3"><%= shop.expiresAt?new Date(shop.expiresAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}):'-' %></td><td class="p-3"><div class="flex justify-end items-center gap-3"><a href="<%= shop.managementUrl %>" target="_blank" rel="noopener" class="text-[var(--gold)] font-semibold">เปิดหลังบ้าน ↗</a><form method="post" action="/admin/rentals/<%= encodeURIComponent(shop.id) %>/delete" onsubmit="var n=prompt('พิมพ์ชื่อร้านเพื่อยืนยัน');if(n!==this.dataset.name)return false;this.confirmName.value=n" data-name="<%= shop.name %>"><input type="hidden" name="confirmName"><button class="text-red-400">ลบร้าน</button></form></div></td></tr><% }) %><% if(!rentedShops.length){ %><tr><td colspan="4" class="p-6 text-center">ยังไม่มีร้าน</td></tr><% } %></tbody></table></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-5 mb-6"><h2 class="font-semibold mb-3">แจ้งเตือน Discord — <%= discordReady?'พร้อมใช้งาน':discordConfigured?'กำลังเชื่อมต่อ':'ยังไม่ตั้ง Token' %></h2><form action="/admin/discord/settings" method="post" class="grid sm:grid-cols-2 gap-3"><label><input type="checkbox" name="enabled" <%= discordSettings.enabled?'checked':'' %>> เปิดแจ้งเตือน</label><span></span><% [['notifyChannelId','ห้องแจ้งเตือน'],['ticketPanelChannelId','ห้องปุ่มตั๋ว'],['ticketCategoryId','หมวดหมู่ตั๋ว'],['ticketLogChannelId','ห้องบันทึก'],['supportRoleId','บทบาททีมงาน']].forEach(x=>{ %><label class="text-xs"><%= x[1] %><input name="<%= x[0] %>" value="<%= discordSettings[x[0]]||'' %>" class="block w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg p-2"></label><% }) %><button class="bg-[var(--gold)] text-[var(--bg)] rounded-lg p-2">บันทึก</button></form><form action="/admin/discord/post-ticket-panel" method="post" class="mt-3"><button class="border rounded-lg p-2">โพสต์ปุ่มเปิดตั๋ว</button></form></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto"><h2 class="font-semibold p-4">ประวัติรายการเช่า</h2><table class="w-full text-sm min-w-[650px]"><tbody><% transactions.forEach(t=>{ %><tr class="border-t border-[var(--border)]"><td class="p-3"><%= t.username %></td><td class="p-3"><%= t.note %></td><td class="p-3">฿<%= Math.abs(Number(t.amount)).toLocaleString() %></td><td class="p-3"><%= new Date(t.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) %></td></tr><% }) %></tbody></table></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-xl overflow-x-auto mt-6"><h2 class="font-semibold p-4">ประวัติคีย์และเว็บเช่าแบบเดิม</h2><table class="w-full text-sm min-w-[650px]"><tbody><% sales.forEach(s=>{ %><tr class="border-t border-[var(--border)]"><td class="p-3"><%= s.username %></td><td class="p-3"><%= s.days %> วัน</td><td class="p-3">฿<%= Number(s.price||0).toLocaleString() %></td><td class="p-3"><%= new Date(s.createdAt).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) %></td></tr><% }) %><% if(!sales.length){ %><tr><td class="p-4">ยังไม่มีประวัติแบบเดิม</td></tr><% } %></tbody></table></section>
</div><script>(function(){const form=document.getElementById('tenant-feature-form');if(!form)return;form.addEventListener('submit',function(event){const scope=form.querySelector('[name="scope"]:checked')?.value;if(scope==='selected'&&!form.querySelector('[name="shopIds"]:checked')){event.preventDefault();alert('กรุณาเลือกร้านอย่างน้อย 1 ร้าน');return}if(scope==='all'&&!confirm('ยืนยันแก้ไขฟีเจอร์นี้กับเว็บเช่าทุกร้าน?'))event.preventDefault()})})();</script></body></html>
