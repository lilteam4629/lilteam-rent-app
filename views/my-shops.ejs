<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/tailwind.generated.css?v=cf54bef"><link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet"><%- include('_head-style') %><%- include('_theme-init') %></head><body>
<header class="cloud-header"><div class="cloud-container cloud-header-inner"><a class="cloud-brand" href="/">LILTEAM <b>CLOUD</b></a><div class="cloud-header-actions"><span><%= currentUser ? currentUser.username : '' %></span><button class="cloud-theme-button" data-cloud-theme aria-label="สลับธีม" type="button"><svg viewBox="0 0 24 24"><path d="M20 15a8 8 0 0 1-11-11 8.5 8.5 0 1 0 11 11Z"/></svg></button><form action="/logout" method="post"><button type="submit">ออกจากระบบ</button></form></div></div></header>
<main class="cloud-container cloud-member-main"><%- include('_member-nav', { active: 'shops' }) %><div class="cloud-admin-head"><div><h1>ร้านของคุณ ทุกอย่างอยู่ที่นี่.</h1><p>เปิดหน้าร้าน เข้าหลังบ้าน และดูระยะเวลาที่เหลือได้ในที่เดียว</p></div><a class="cloud-button" href="/start">เปิดร้านใหม่ ↗</a></div>
<% messages.error.forEach(m => { %><p class="cloud-member-alert error" role="alert"><%= m %></p><% }); messages.success.forEach(m => { %><p class="cloud-member-alert" role="status"><%= m %></p><% }); %>
<div class="cloud-member-summary"><div><span>ร้านทั้งหมด</span><strong><%= shops.length %> ร้าน</strong></div><div><span>เครดิตเว็บเช่า</span><strong>฿<%= Number(currentUser?.walletBalance || 0).toLocaleString('th-TH') %></strong></div><a href="/wallet">เติมเครดิตสำหรับเปิดร้านและต่ออายุ ↗</a></div>
<% if (!shops.length) { %><div class="cloud-empty"><h2>ร้านแรกของคุณ เริ่มได้เลย</h2><p>เลือกแพ็กเกจ ตั้งชื่อร้าน แล้วจัดการสินค้าผ่านหลังบ้านของคุณ</p><a class="cloud-button" href="/start">สร้างร้านแรก ↗</a></div><% } else { %><div class="cloud-shop-list"><% shops.forEach(shop => { const expired = Number(shop.expiresAt) <= Date.now(); %><article class="cloud-shop"><div class="cloud-shop-head"><div><h2><%= shop.name %></h2><a href="<%= shop.url %>" target="_blank" rel="noopener"><%= shop.url.replace(/^https?:\/\//,'') %> ↗</a></div><span class="cloud-shop-status <%= expired ? 'expired' : '' %>"><%= expired ? 'หมดอายุ' : 'เปิดใช้งาน' %></span></div><div class="cloud-shop-life"><span>หมดอายุ <%= new Date(Number(shop.expiresAt)).toLocaleDateString('th-TH',{timeZone:'Asia/Bangkok',year:'numeric',month:'short',day:'numeric'}) %></span><strong class="countdown" data-exp="<%= shop.expiresAt %>"></strong></div><div class="cloud-shop-actions"><a class="cloud-button outline" href="<%= shop.url %>" target="_blank" rel="noopener">เปิดหน้าร้าน ↗</a><a class="cloud-button" href="<%= shop.url.replace(/\/$/,'') %>/admin" target="_blank" rel="noopener">เข้าหลังร้าน ↗</a></div><details class="cloud-shop-renew"><summary>ต่ออายุร้านนี้</summary><form action="/my-shops/<%= shop.id %>/renew" method="post"><label for="renew-<%= shop.id %>">แพ็กเกจต่ออายุ</label><select id="renew-<%= shop.id %>" name="planId" required><% plans.forEach(plan => { %><option value="<%= plan.id %>"><%= plan.days %> วัน — ฿<%= Number(plan.price).toLocaleString('th-TH') %></option><% }) %></select><p>หักจากเครดิตเว็บเช่าของคุณหลังยืนยัน</p><button class="cloud-button small" type="submit" <%= plans.length ? '' : 'disabled' %>>ยืนยันต่ออายุ</button></form></details></article><% }) %></div><% } %>
</main><%- include('_music-player') %><script>(()=>{function tick(){document.querySelectorAll('.countdown').forEach(el=>{const ms=Number(el.dataset.exp)-Date.now();el.textContent=ms<=0?'ต่ออายุเพื่อใช้งานต่อ':`เหลือ ${Math.floor(ms/86400000)} วัน ${Math.floor(ms%86400000/3600000)} ชั่วโมง`;});}tick();setInterval(tick,30000);})();</script></body></html>
