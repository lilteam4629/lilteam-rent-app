<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/tailwind.generated.css?v=cf54bef">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%- include('_head-style') %>
  <%- include('_theme-init') %>
</head>
<body class="cloud-auth-page min-h-screen flex items-center justify-center p-4">
  <%- include('_public-theme-toggle') %>
  <%- include('_report-issue-button') %>
  <div class="cloud-auth-card w-full max-w-sm bg-[var(--card)] border border-[var(--border)] rounded-2xl p-6">
    <div class="mb-4">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs text-[var(--text-3)] hover:text-[var(--gold)] transition-colors">
        <span>←</span> <span>กลับหน้าหลัก</span>
      </a>
    </div>
    <div class="text-center mb-5">
      <div class="text-3xl mb-2">🛠️</div>
      <h1 class="text-xl font-bold">หลังบ้านเจ้าของเว็บเช่า</h1>
      <p class="text-sm text-[var(--text-3)] mt-1">จัดการแพ็กเกจ ร้านเช่า สมาชิก การเติมเงิน และหน้าเว็บ</p>
    </div>

    <% messages.error.forEach(m => { %>
      <div class="bg-[var(--coral)]/10 border border-[var(--coral)]/50 text-[var(--coral)] px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
    <% }) %>
    <% messages.success.forEach(m => { %>
      <div class="bg-emerald-500/10 border border-emerald-500/40 text-emerald-400 px-4 py-2 rounded-lg mb-3 text-sm text-center"><%= m %></div>
    <% }) %>

    <form action="/admin/login" method="post" class="space-y-3">
      <input name="username" aria-label="ชื่อผู้ใช้" autocomplete="username" required placeholder="ชื่อผู้ใช้เจ้าของเว็บ" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2.5 text-sm" />
      <input name="password" aria-label="รหัสผ่าน" type="password" autocomplete="current-password" required placeholder="รหัสผ่าน" class="w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg px-3 py-2.5 text-sm" />
      <button class="w-full bg-[var(--gold)] hover:bg-[var(--gold-hover)] text-[var(--button-text)] font-semibold rounded-lg py-2.5 text-sm">เข้าสู่ระบบ</button>
    </form>
  </div>
</body>
</html>
