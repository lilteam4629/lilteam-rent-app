<% const navItems = [
  { key: 'branding', href: '/admin', icon: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z', label: 'ภาพรวมและหน้าเว็บ' },
  { key: 'rentals', href: '/admin/rentals', icon: 'M3 10h18M5 10v11h14V10M3 10l2-7h14l2 7M9 21v-7h6v7', label: 'ร้านเช่าและประวัติ' },
  { key: 'plans', href: '/admin/plans', icon: 'M3 6h18v13H3zM3 10h18M7 15h4', label: 'แพ็กเกจราคา' },
  { key: 'topups', href: '/admin/topups', icon: 'M6 3h12v18H6zM9 7h6M9 11h6M9 15h3', label: 'เติมเงิน & ตรวจสลิป' },
  { key: 'payment', href: '/admin/payment', icon: 'M12 3l8 4v6c0 4-8 8-8 8S4 17 4 13V7l8-4Zm-4 9 3 3 5-6', label: 'ระบบรับเงิน', badge: 'ตรวจสลิปอัตโนมัติ' },
  { key: 'users', href: '/admin/users', icon: 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21v-3c0-3 3-5 8-5s8 2 8 5v3', label: 'บัญชีผู้ใช้' },
]; %>
<aside class="admin-sidebar">
  <div class="h-[5.4rem] px-5 flex items-center gap-3 border-b border-[var(--border)]">
    <% if (logoImage) { %><img src="<%= logoImage %>" class="w-10 h-10 rounded-xl object-contain bg-[var(--input)]" /><% } else { %><span class="w-10 h-10 rounded-xl bg-[var(--gold)] text-[var(--button-text)] grid place-items-center">🏪</span><% } %>
    <div><div class="font-bold leading-tight"><%= shopName %> Cloud</div><div class="text-[11px] text-[var(--gold)]">ศูนย์จัดการเว็บเช่า</div></div><button class="cloud-admin-menu-toggle" data-cloud-admin-menu type="button" aria-expanded="false" aria-controls="cloud-admin-navigation">เมนู</button>
  </div>
  <nav class="p-3 space-y-1 flex-1" id="cloud-admin-navigation" aria-label="เมนูผู้ดูแลเว็บเช่า">
    <p class="px-3 pt-2 pb-1 text-[10px] font-bold tracking-widest text-[var(--text-4)]">จัดการระบบ</p>
    <% navItems.forEach(function(item) { %><a href="<%= item.href %>" class="admin-nav-link <%= active === item.key ? 'active' : '' %>" <%= active === item.key ? 'aria-current=page' : '' %>><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= item.icon %>"/></svg><span><%= item.label %><% if(item.badge){ %><small class="block text-[9px]"><%= item.badge %></small><% } %></span></a><% }) %>
    <p class="px-3 pt-5 pb-1 text-[10px] font-bold tracking-widest text-[var(--text-4)]">เว็บไซต์</p>
    <a href="/" class="admin-nav-link"><span class="text-lg">⌂</span>ดูหน้าหลัก</a>
  </nav>
  <form action="/admin/logout" method="post" class="p-4 border-t border-[var(--border)]"><button class="admin-nav-link w-full"><span>↪</span>ออกจากระบบ</button></form>
</aside>
<header class="admin-topbar">
  <div><p class="text-[11px] text-[var(--text-4)]">หลังบ้าน /</p><strong><%= (navItems.find(function(x){ return x.key === active; }) || {}).label || 'แดชบอร์ด' %></strong></div>
  <button id="admin-theme-toggle" type="button" class="border border-[var(--border-light)] bg-[var(--input)] rounded-xl px-4 py-2 text-sm hover:border-[var(--gold)]">☀️ สลับมืด/สว่าง</button>
</header>
<script>(function(){var b=document.getElementById('admin-theme-toggle');if(!b)return;b.onclick=function(){var n=document.documentElement.getAttribute('data-theme')==='light'?'dark':'light';document.documentElement.setAttribute('data-theme',n);try{localStorage.setItem('rentTheme',n)}catch(e){}}})();</script>
