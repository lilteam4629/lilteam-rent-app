<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><script src="https://cdn.tailwindcss.com"></script><%- include('_head-style') %><%- include('_theme-init') %></head><body class="admin-page"><div class="admin-content"><%- include('_admin-nav',{active:'payment'}) %>
<% messages.error.forEach(m=>{ %><div class="p-3 mb-3 bg-red-500/10 text-red-400 rounded-xl"><%= m %></div><% }) %><% messages.success.forEach(m=>{ %><div class="p-3 mb-3 bg-emerald-500/10 text-emerald-400 rounded-xl"><%= m %></div><% }) %>
<form method="post" action="/admin/payment" class="space-y-5">
<section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5"><div class="flex items-start justify-between gap-3"><div><h1 class="text-xl font-bold">ตั้งค่าตรวจสลิปอัตโนมัติ</h1><p class="text-xs text-[var(--text-4)] mt-1">ใช้ EasySlip ตรวจยอดและสลิปซ้ำให้อัตโนมัติ</p></div><span class="text-[10px] bg-emerald-500/15 text-emerald-500 rounded-lg px-2 py-1 font-bold">EasySlip</span></div>
<label class="text-xs block mt-5">EasySlip API Key<input type="password" name="easyslipApiKey" value="<%= payment.easyslipApiKey||'' %>" class="block w-full mt-1 bg-[var(--input)] border border-[var(--border-light)] rounded-xl p-3"></label>
<button type="button" id="test" class="mt-4 border border-[var(--gold)] text-[var(--gold)] rounded-xl px-4 py-2.5 font-semibold">ทดสอบ EasySlip</button><span id="testResult" class="ml-2 text-sm"></span></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5"><h2 class="font-bold mb-1">บัญชีรับเงิน</h2><p class="text-xs text-[var(--text-4)] mb-4">ข้อมูลพร้อมเพย์และบัญชีธนาคารของเว็บหลักถูกนำมาให้แล้ว</p><div class="grid sm:grid-cols-2 gap-3"><% [['promptpayId','เลขพร้อมเพย์'],['promptpayName','ชื่อพร้อมเพย์'],['bankName','ธนาคาร'],['bankAccountNumber','เลขบัญชี'],['bankAccountName','ชื่อบัญชี']].forEach(x=>{ %><label class="text-xs"><%= x[1] %><input name="<%= x[0] %>" value="<%= payment[x[0]]||'' %>" class="block w-full mt-1 bg-[var(--input)] border border-[var(--border-light)] rounded-xl p-3"></label><% }) %></div></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5"><h2 class="font-bold mb-4">ซองของขวัญ TrueMoney</h2><label class="flex items-center gap-2"><input type="checkbox" name="truemoneyEnabled" <%= payment.truemoneyEnabled?'checked':'' %>> เปิดรับซองและเติมยอดอัตโนมัติ</label><input name="truemoneyPhone" value="<%= payment.truemoneyPhone||'' %>" placeholder="เบอร์รับเงิน 10 หลัก" class="mt-3 w-full bg-[var(--input)] border border-[var(--border-light)] rounded-xl p-3"></section>
<button class="bg-[var(--gold)] text-[var(--bg)] rounded-xl px-5 py-3 font-bold">บันทึกทั้งหมด</button></form></div>
<script>document.getElementById('test').onclick=async()=>{const f=document.querySelector('form'),r=document.getElementById('testResult');r.textContent='กำลังทดสอบ...';const x=await fetch('/admin/payment/test',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(f))});const j=await x.json();r.textContent=(j.ok?'✓ ':'✕ ')+(j.message||'');r.className=j.ok?'ml-2 text-emerald-500':'ml-2 text-red-500'};</script></body></html>

