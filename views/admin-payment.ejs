<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><script src="https://cdn.tailwindcss.com"></script><%- include('_head-style') %><%- include('_theme-init') %></head><body class="admin-page"><div class="admin-content"><%- include('_admin-nav',{active:'payment'}) %><% messages.error.forEach(m=>{ %><div class="p-3 mb-3 bg-red-500/10 text-red-400 rounded-xl"><%= m %></div><% }) %><% messages.success.forEach(m=>{ %><div class="p-3 mb-3 bg-emerald-500/10 text-emerald-400 rounded-xl"><%= m %></div><% }) %>
<form method="post" action="/admin/payment" class="space-y-5"><section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5"><h2 class="font-bold mb-1">ตั้งค่าตรวจสลิปอัตโนมัติ</h2><p class="text-xs text-emerald-400 mb-4">Multi-API</p><select name="slipProvider" id="provider" class="w-full bg-[var(--input)] border rounded-xl p-3"><% [['none','ตรวจด้วยแอดมิน'],['easyslip','EasySlip'],['slipok','SlipOK'],['slipcheck','SlipCheck'],['rdcw','SlipRDCW'],['slip2go','Slip2Go']].forEach(x=>{ %><option value="<%= x[0] %>" <%= payment.slipProvider===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select><div class="grid sm:grid-cols-2 gap-3 mt-4"><% [['easyslipApiKey','EasySlip API Key'],['slipokBranchId','SlipOK Branch ID'],['slipokApiKey','SlipOK API Key'],['slipcheckApiKey','SlipCheck API Key'],['slipcheckEndpoint','SlipCheck Endpoint'],['rdcwClientId','SlipRDCW Client ID'],['rdcwClientSecret','SlipRDCW Client Secret'],['rdcwEndpoint','SlipRDCW Endpoint'],['slip2goApiKey','Slip2Go API Key'],['slip2goEndpoint','Slip2Go Endpoint']].forEach(x=>{ %><label class="text-xs"><%= x[1] %><input name="<%= x[0] %>" value="<%= payment[x[0]]||'' %>" class="block w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg p-2"></label><% }) %></div><button type="button" id="test" class="mt-3 border border-[var(--gold)] rounded-lg px-3 py-2">ทดสอบ API ที่เลือก</button><span id="testResult" class="ml-2 text-sm"></span></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5"><h2 class="font-bold mb-4">บัญชีรับเงิน</h2><div class="grid sm:grid-cols-2 gap-3"><% [['promptpayId','เลขพร้อมเพย์'],['promptpayName','ชื่อพร้อมเพย์'],['bankName','ธนาคาร'],['bankAccountNumber','เลขบัญชี'],['bankAccountName','ชื่อบัญชี']].forEach(x=>{ %><label class="text-xs"><%= x[1] %><input name="<%= x[0] %>" value="<%= payment[x[0]]||'' %>" class="block w-full bg-[var(--input)] border border-[var(--border-light)] rounded-lg p-2"></label><% }) %></div></section>
<section class="bg-[var(--card)] border border-[var(--border)] rounded-2xl p-5"><h2 class="font-bold mb-4">TrueMoney</h2><label><input type="checkbox" name="truemoneyEnabled" <%= payment.truemoneyEnabled?'checked':'' %>> เปิดรับซองของขวัญ</label><input name="truemoneyPhone" value="<%= payment.truemoneyPhone||'' %>" placeholder="เบอร์รับเงิน 10 หลัก" class="mt-3 w-full bg-[var(--input)] border rounded-xl p-3"></section><button class="bg-[var(--gold)] text-[var(--bg)] rounded-xl px-5 py-3 font-bold">บันทึกทั้งหมด</button></form></div><script>document.getElementById('test').onclick=async()=>{const f=document.querySelector('form'),r=document.getElementById('testResult');r.textContent='กำลังทดสอบ...';const x=await fetch('/admin/payment/test',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(f))});const j=await x.json();r.textContent=(j.ok?'✓ ':'✕ ')+(j.message||'');r.className=j.ok?'ml-2 text-emerald-400':'ml-2 text-red-400'}</script></body></html>
