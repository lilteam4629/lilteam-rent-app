<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><meta name="description" content="เช่าเว็บร้านค้ากับ LilTeam Cloud ดูตัวอย่างหน้าร้านและหลังบ้าน เลือกแพ็กเกจและจัดการร้านในที่เดียว"><link rel="stylesheet" href="/css/tailwind.generated.css?v=cf54bef"><link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800&display=swap" rel="stylesheet"><%- include('_head-style') %><%- include('_theme-init') %></head><body class="cloud-landing">
<header class="cloud-header"><div class="cloud-container cloud-header-inner"><a href="/" class="cloud-brand"><span class="cloud-brand-mark"><% if (logoImage) { %><img src="<%= logoImage %>" alt=""><% } else { %><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M8 7v18h17M14 7v12h11"/></svg><% } %></span>LILTEAM <b>CLOUD</b></a><nav class="cloud-desktop-nav" aria-label="เมนูหลัก"><a href="#example">ตัวอย่างเว็บ</a><a href="#features">ระบบของร้าน</a><a href="#packages">แพ็กเกจ</a></nav><div class="cloud-header-actions"><button class="cloud-theme-button" data-cloud-theme type="button" aria-label="สลับธีมสว่างและมืด"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15a8 8 0 0 1-11-11 8.5 8.5 0 1 0 11 11Z"/></svg></button><a href="<%= currentUser ? '/my-shops' : '/login' %>"><%= currentUser ? 'ร้านของฉัน' : 'เข้าสู่ระบบ' %></a><a class="cloud-button small" href="/start">เปิดร้าน ↗</a></div></div></header>
<main><section class="cloud-hero"><div class="cloud-container cloud-hero-grid"><div class="cloud-hero-copy"><h1><% if (heroCustomized) { %><%= heroTitle %><% } else { %>ร้านในแบบคุณ<br>เริ่มต้นที่<span>นี่.</span><% } %></h1><p><%= heroCustomized ? heroSubtitle : 'เปลี่ยนไอเดียของคุณให้เป็นร้านค้าออนไลน์ พร้อมหน้าร้าน ระบบสินค้า และหลังบ้านที่จัดการได้เอง ทุกอย่างเชื่อมกันในที่เดียว' %></p><div class="cloud-hero-actions"><a class="cloud-button" href="/start">เริ่มเปิดร้านของคุณ ↗</a><a class="cloud-text-link" href="#example">ดูเว็บที่คุณจะได้ ↓</a></div><div class="cloud-hero-note"><span class="cloud-dot"></span> ดูตัวอย่างจริงก่อนเลือกแพ็กเกจ</div></div><div class="cloud-hero-stage"><span class="cloud-stage-word" aria-hidden="true">YOUR STORE.</span><div class="cloud-browser hero-browser"><div class="cloud-browser-bar"><span class="cloud-window-dots" aria-hidden="true">● ● ●</span><span>lilteam.site</span><span>↗</span></div><img src="/images/showcase/home.jpg" width="1440" height="960" alt="ภาพหน้าแรกของเว็บ LilTeam Shop จริง" fetchpriority="high"></div><div class="cloud-stage-caption"><span>หน้าร้านจริงของ LILTEAM</span><a href="<%= mainSiteUrl %>" target="_blank" rel="noopener">เปิดดูเว็บจริง ↗</a></div><div class="cloud-stage-stamp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg><span>หน้าร้าน + หลังบ้าน<br><b>พร้อมเริ่มขาย</b></span></div></div></div></section>
<div class="cloud-capability-strip"><div class="cloud-container"><span>หน้าร้านออนไลน์</span><i>+</i><span>สินค้าและสต็อก</span><i>+</i><span>กระเป๋าเงิน</span><i>+</i><span>คำสั่งซื้อ</span><i>+</i><span>หลังบ้านร้านค้า</span></div></div>
<%- include('_store-motion') %>
<section id="example" class="cloud-section cloud-container"><div class="cloud-section-heading"><h2>เปิดดูทุกมุม<br>ของร้านคุณ</h2><p>ภาพจากหน้าเว็บ LilTeam ให้คุณเห็นหน้าตาและวิธีจัดการร้านก่อนเริ่มใช้งาน</p></div><% const screens = typeof websiteScreens !== 'undefined' ? websiteScreens : []; %><div class="cloud-tour"><div class="cloud-tour-tabs" role="tablist" aria-label="ตัวอย่างหน้าเว็บ"><% screens.forEach((screen, i) => { %><button type="button" id="screen-tab-<%= i %>" role="tab" aria-selected="<%= i === 0 %>" aria-controls="screen-panel-<%= i %>" tabindex="<%= i ? '-1' : '0' %>" data-screen-tab="<%= i %>"><span><%= screen.title %></span><small><%= screen.category %></small></button><% }) %></div><div class="cloud-tour-main"><% screens.forEach((screen, i) => { %><div role="tabpanel" id="screen-panel-<%= i %>" aria-labelledby="screen-tab-<%= i %>" data-screen-panel="<%= i %>" <%= i ? 'hidden' : '' %>><div class="cloud-browser"><div class="cloud-browser-bar"><span class="cloud-window-dots" aria-hidden="true">● ● ●</span><span><%= screen.path %></span><button type="button" data-expand-screen="<%= screen.image %>" data-expand-title="<%= screen.title %>">ขยายภาพ ↗</button></div><img src="<%= screen.image %>" width="1440" height="960" alt="<%= screen.title %> — <%= screen.demo ? 'ข้อมูลตัวอย่าง' : 'ภาพหน้าเว็บจริง' %>" loading="lazy"></div><div class="cloud-screen-caption"><div><h3><%= screen.title %></h3><p><%= screen.description %></p></div><span><%= screen.demo ? 'หลังบ้าน · ข้อมูลตัวอย่าง' : 'ภาพจากเว็บจริง' %></span></div></div><% }) %></div></div><% if (showcaseImages && showcaseImages.length) { %><div class="cloud-extra-gallery"><h3>ภาพเพิ่มเติมจากร้าน</h3><div><% showcaseImages.forEach((src, i) => { %><img src="<%= src %>" alt="ตัวอย่างเพิ่มเติม <%= i + 1 %>" width="480" height="320" loading="lazy"><% }) %></div></div><% } %></section>
<section id="features" class="cloud-features"><div class="cloud-container cloud-features-grid"><div><h2>คุณดูแลร้าน<br>ระบบดูแลงาน.</h2><p>เริ่มจากระบบที่เชื่อมต่อกัน แล้วปรับร้านให้เป็นแบรนด์ของคุณ</p><a href="/start" class="cloud-text-link">สร้างร้านของคุณ ↗</a></div><div class="cloud-feature-list"><% [['สินค้าและสต็อก','เพิ่มสินค้า เติมสต็อก และดูรายการพร้อมขายในหลังบ้านเดียวกัน','M4 7l8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10'],['คำสั่งซื้อและการส่งมอบ','เก็บรายการซื้อและข้อมูลส่งมอบ พร้อมติดตามสถานะของแต่ละคำสั่งซื้อ','M6 3h12v18H6zM9 7h6M9 11h6M9 15h4'],['กระเป๋าเงินและตรวจสลิป','รองรับเครดิตในร้านและการตรวจสลิปตามผู้ให้บริการที่ตั้งค่า','M3 6h18v14H3zM3 10h18M16 14h3'],['ปรับร้านและระบบเสริม','ตั้งค่าแบรนด์ จัดหมวดสินค้า และใช้ระบบเสริมที่เปิดให้ร้านของคุณ','M12 3v4M12 17v4M3 12h4M17 12h4M6 6l3 3M15 15l3 3']].forEach(feature => { %><article><svg viewBox="0 0 24 24" aria-hidden="true"><path d="<%= feature[2] %>"/></svg><div><h3><%= feature[0] %></h3><p><%= feature[1] %></p></div></article><% }) %></div></div></section>
<section id="packages" class="cloud-section cloud-container"><div class="cloud-section-heading"><h2>เลือกเวลาที่ใช่<br>แล้วเริ่มร้านของคุณ</h2><p>ราคาและระยะเวลาจากแพ็กเกจที่เปิดขายจริง ต่ออายุร้านจากบัญชีของคุณได้</p></div><% if (!plans.length) { %><div class="cloud-empty"><h3>ยังไม่มีแพ็กเกจเปิดขาย</h3><p>ติดต่อทีมงานเพื่อสอบถามการเปิดร้าน</p><a class="cloud-button" href="<%= discordInviteUrl %>" target="_blank" rel="noopener">ติดต่อทีมงาน ↗</a></div><% } else { %><div class="cloud-plans"><% plans.forEach((plan, i) => { %><article class="cloud-plan <%= i === 0 ? 'featured' : '' %>"><div class="cloud-plan-top"><h3><%= plan.days %> วัน</h3><% if (plan.promo) { %><span>โปรโมชั่น</span><% } %></div><div class="cloud-plan-price">฿<%= Number(plan.price).toLocaleString('th-TH') %><small> / รอบ</small></div><p>เว็บร้านค้าของคุณ พร้อมระบบจัดการ</p><ul><li>โดเมนย่อย .<%= mainDomain %></li><li>หน้าร้านและหลังบ้าน</li><li>สินค้า สต็อก และคำสั่งซื้อ</li><li>กระเป๋าเงินและระบบเติมเงิน</li></ul><a class="cloud-button <%= i === 0 ? '' : 'outline' %>" href="/start?plan=<%= encodeURIComponent(plan.id) %>">เลือกแพ็กเกจนี้ ↗</a></article><% }) %></div><% } %></section>
<section class="cloud-start-section cloud-container"><h2>จากไอเดีย<br>สู่ร้านของคุณ.</h2><div><ol><li><b>เลือกแพ็กเกจ</b><span>เลือกระยะเวลาที่เหมาะกับการใช้งาน</span></li><li><b>ตั้งค่าร้าน</b><span>กำหนดชื่อ ลิงก์ และบัญชีผู้ดูแลร้าน</span></li><li><b>เติมเครดิตและเปิดร้าน</b><span>ตรวจข้อมูลก่อนยืนยัน จากนั้นเข้าจัดการร้านได้</span></li></ol><a class="cloud-button" href="/start">เริ่มตั้งค่าร้าน ↗</a></div></section>
<section class="cloud-faq cloud-container"><h2>ก่อนเริ่ม มีคำถามไหม?</h2><div><details><summary>เข้าไปดูตัวอย่างร้านจริงได้ไหม?</summary><p>เปิดดูร้านจริงได้ที่ <a href="<%= mainSiteUrl %>" target="_blank" rel="noopener">LilTeam Shop</a> ภาพหลังบ้านใช้ข้อมูลทดสอบเพื่อรักษาข้อมูลลูกค้า</p></details><details><summary>ใช้เครดิตจากเว็บร้านหลักได้ไหม?</summary><p>บัญชีและเครดิตของเว็บเช่าแยกจากหน้าร้าน ใช้เมนูเติมเงินในเว็บเช่าเพื่อเตรียมเครดิตสำหรับเปิดร้านและต่ออายุ</p></details><details><summary>ต่ออายุร้านตรงไหน?</summary><p>เข้าสู่ระบบแล้วไปที่ “ร้านของฉัน” เลือกแพ็กเกจต่ออายุให้ร้านที่ต้องการ</p></details><details><summary>ต้องการความช่วยเหลือทำอย่างไร?</summary><p><a href="<%= discordInviteUrl %>" target="_blank" rel="noopener">ติดต่อทีมงานผ่าน Discord ↗</a></p></details></div></section></main>
<footer class="cloud-footer"><div class="cloud-container"><a href="/" class="cloud-brand">LILTEAM <b>CLOUD</b></a><span>พื้นที่เริ่มต้นร้านค้าออนไลน์ของคุณ</span><div><a href="/my-shops">ร้านของฉัน</a><a href="/wallet">เติมเงิน</a><a href="<%= discordInviteUrl %>" target="_blank" rel="noopener">ติดต่อทีมงาน ↗</a></div></div></footer><dialog class="cloud-image-dialog" data-screen-dialog><button type="button" data-close-screen aria-label="ปิดภาพตัวอย่าง">ปิด ×</button><h2 data-screen-title></h2><img data-screen-full src="/images/showcase/home.jpg" alt="ภาพตัวอย่างหน้าเว็บ"></dialog><%- include('_music-player') %></body></html>
